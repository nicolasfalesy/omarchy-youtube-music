#!/usr/bin/env python3
"""cdp-bridge: start the YouTube Music app with its DevTools protocol on a
private pipe, and hand that pipe to the bar widget over a Unix socket that only
this user can open.

Why: the widget needs the DevTools protocol to read the library, search, the
queue and the real play state (the app's API server cannot do those). The
usual way to get it, --remote-debugging-port, opens an unauthenticated TCP port
on 127.0.0.1 that gives ANY local program or user full control of the signed-in
app, cookies included. Chromium's --remote-debugging-pipe speaks the same
protocol over two inherited file descriptors instead (the app reads commands on
fd 3 and writes answers on fd 4), so no port exists at all. This program is the
app's parent and the only holder of those pipes. It serves them on
$XDG_RUNTIME_DIR/nic-youtube-music/cdp.sock: the folder is 0700 and the socket
0600, and each connection's peer uid is checked, so other users cannot reach it.

Framing: the pipe separates messages with a NUL byte; the socket uses a
newline, which JSON text never contains raw, so the widget can split lines.

It also refuses to pass on any switch that opens a debugging channel, from
~/.config/youtube-music-flags.conf or its own arguments: --remote-debugging-*
(a leftover port line from an older setup cannot reopen the port) and Node's
--inspect* (Electron honours those in the app's build and opens an
unauthenticated debugger on a TCP port). NODE_OPTIONS and ELECTRON_RUN_AS_NODE
are dropped from the app's environment for the same reason.

Usage: cdp-bridge [extra app arguments...]
Started by the widget when the app is needed, and by the app's menu entry
(tools/setup installs one), so the app is never started with an open port.
"""

import json
import os
import select
import signal
import socket
import stat
import struct
import sys
import time

APP = os.environ.get("NIC_YTM_APP", "/opt/YouTube Music/youtube-music")
FLAGS_FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                          "youtube-music-flags.conf")
MAX_PENDING = 256 * 1024 * 1024  # bytes without a separator before a peer is dropped
MAX_CLIENTS = 8  # one per monitor copy of the widget, plus a quit from lock-api


def die(msg, code=1):
    print("cdp-bridge: " + msg, file=sys.stderr)
    sys.exit(code)


def private_dir():
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    if not rt:
        die("XDG_RUNTIME_DIR is not set")
    st = os.lstat(rt)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        die("XDG_RUNTIME_DIR is not a private directory owned by this user")
    d = os.path.join(rt, "nic-youtube-music")
    try:
        os.mkdir(d, 0o700)
    except FileExistsError:
        pass
    st = os.lstat(d)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        die(d + " is not a directory owned by this user")
    os.chmod(d, 0o700)
    return d


def opens_debugging(word):
    """True for a switch that opens a debugging channel. Chromium also reads
    switches written with one dash, and Node reads "_" as "-" in its own, so
    the name is compared with both spellings folded."""
    if not word.startswith("-"):
        return False
    name = word.lstrip("-").split("=", 1)[0].replace("_", "-").lower()
    return name.startswith(("remote-debugging-", "inspect"))


def keep(words, source):
    out = []
    for word in words:
        if opens_debugging(word):
            print("cdp-bridge: ignoring " + word.split("=", 1)[0] + " from " + source
                  + " (the debugging channel is the private pipe)", file=sys.stderr)
            continue
        out.append(word)
    return out


def app_argv(extra):
    flags = []
    try:
        with open(FLAGS_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                flags += keep(line.split(), FLAGS_FILE)
    except OSError:
        pass
    # The menu entry's %U lands in extra: filtered the same way.
    return [APP] + flags + ["--remote-debugging-pipe"] + keep(extra, "the command line")


def app_env():
    env = dict(os.environ, ELECTRON_IS_DEV="0")
    # Node's own switches reach the app's main process through these too.
    for name in ("NODE_OPTIONS", "ELECTRON_RUN_AS_NODE"):
        env.pop(name, None)
    return env


def peer_uid(conn):
    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", creds)[1]


def main():
    d = private_dir()
    path = os.path.join(d, "cdp.sock")

    # One bridge (so one app) at a time. A socket that answers means it runs.
    if os.path.exists(path):
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.connect(path)
            probe.close()
            return 0
        except OSError:
            os.unlink(path)

    to_app_r, to_app_w = os.pipe()        # app reads commands on fd 3
    from_app_r, from_app_w = os.pipe()    # app writes answers on fd 4
    argv = app_argv(sys.argv[1:])
    env = app_env()

    pid = os.fork()
    if pid == 0:
        try:
            # Park the pipe ends above 4 first so dup2 cannot clobber one with the other.
            a = os.dup(to_app_r)
            b = os.dup(from_app_w)
            os.dup2(a, 3)
            os.dup2(b, 4)
            devnull = os.open(os.devnull, os.O_RDWR)
            for fd in (0, 1, 2):
                os.dup2(devnull, fd)
            os.closerange(5, 1 << 16)
            os.set_inheritable(3, True)
            os.set_inheritable(4, True)
            os.execve(argv[0], argv, env)
        except Exception:
            os._exit(127)
    os.close(to_app_r)
    os.close(from_app_w)

    old_umask = os.umask(0o177)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(path)
    os.umask(old_umask)
    os.chmod(path, 0o600)
    server.listen(4)

    stopping = []
    # Never forward a TERM to the app: Chromium crashes on purpose on SIGTERM.
    # The widget quits it with Browser.close over this socket instead.
    signal.signal(signal.SIGTERM, lambda *_: stopping.append(1))
    signal.signal(signal.SIGINT, lambda *_: stopping.append(1))
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)

    # Every connection is served at once. One copy of the widget runs per
    # monitor and each opens its own connection; when only the newest was
    # kept, the copies kicked each other off while the app started (each
    # polls the page for readiness), and the clicked copy's library load
    # failed with "not reachable" until the panel was reopened (2026-09-28).
    # Command ids are renumbered here so each answer goes back to the
    # connection that asked (every copy counts its ids from 1); events carry
    # no id and go to every connection.
    clients = {}  # socket -> bytes received without a newline yet
    routes = {}   # bridge id -> (socket, the id that connection used)
    next_id = 0
    from_app = b""

    def drop(conn):
        clients.pop(conn, None)
        for rid in [rid for rid, (c, _) in routes.items() if c is conn]:
            del routes[rid]
        conn.close()

    try:
        while not stopping:
            done, _status = os.waitpid(pid, os.WNOHANG)
            if done:
                break
            watch = [server, from_app_r] + list(clients)
            try:
                ready, _, _ = select.select(watch, [], [], 1.0)
            except InterruptedError:
                continue
            if server in ready:
                conn, _ = server.accept()
                if peer_uid(conn) != os.getuid() or len(clients) >= MAX_CLIENTS:
                    conn.close()
                else:
                    clients[conn] = b""
            if from_app_r in ready:
                chunk = os.read(from_app_r, 1 << 20)
                if not chunk:
                    break  # the app closed its end: it is quitting
                from_app += chunk
                *messages, from_app = from_app.split(b"\0")
                if len(from_app) > MAX_PENDING:
                    from_app = b""
                out = {}  # socket -> lines to send
                for raw in messages:
                    try:
                        msg = json.loads(raw)
                    except ValueError:
                        continue
                    if isinstance(msg, dict) and "id" in msg:
                        route = routes.pop(msg["id"], None)
                        if not route or route[0] not in clients:
                            continue
                        msg["id"] = route[1]
                        out.setdefault(route[0], []).append(json.dumps(msg, separators=(",", ":")).encode())
                    else:
                        for conn in clients:
                            out.setdefault(conn, []).append(raw)
                for conn, lines in out.items():
                    try:
                        conn.sendall(b"".join(line + b"\n" for line in lines))
                    except OSError:
                        drop(conn)
            for conn in [c for c in ready if c in clients]:
                try:
                    chunk = conn.recv(1 << 20)
                except OSError:
                    chunk = b""
                if not chunk:
                    drop(conn)
                    continue
                *lines, rest = (clients[conn] + chunk).split(b"\n")
                if len(rest) > MAX_PENDING:
                    drop(conn)
                    continue
                clients[conn] = rest
                for line in lines:
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    if not isinstance(msg, dict):
                        continue
                    if "id" in msg:
                        next_id += 1
                        routes[next_id] = (conn, msg["id"])
                        msg["id"] = next_id
                    os.write(to_app_w, json.dumps(msg, separators=(",", ":")).encode() + b"\0")
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
        server.close()
        for conn in list(clients):
            conn.close()
        os.close(to_app_w)
        os.close(from_app_r)
    # Reap the app when it exits so it never lingers as a zombie.
    for _ in range(50):
        if os.waitpid(pid, os.WNOHANG)[0]:
            break
        time.sleep(0.1)
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""cdp-bridge: start the YouTube Music app with its DevTools protocol on a
private pipe, and hand that pipe to the bar widget over a Unix socket that only
this user can open.

Why: the widget needs the DevTools protocol to read the library, search, the
queue and the real play state (the app's API server cannot do those). The
usual way to get it, --remote-debugging-port, opens an unauthenticated TCP port
on 127.0.0.1 that gives ANY local program or user full control of the signed-in
app, cookies included. Chromium's --remote-debugging-pipe speaks the same
protocol over two inherited file descriptors instead (the app reads commands on
fd 3 and writes answers on fd 4), so no port exists at all. This program is the
app's parent and the only holder of those pipes. It serves them on
$XDG_RUNTIME_DIR/nic-youtube-music/cdp.sock: the folder is 0700 and the socket
0600, and each connection's peer uid is checked, so other users cannot reach it.

Only the commands the widget and tools/lock-api send reach the app (see
ALLOWED), and Page.navigate only to https://music.youtube.com/. Anything else
gets a CDP error back, so a same-user program that reaches the socket cannot
read cookies, open new pages or fetch arbitrary URLs through it.

Framing: the pipe separates messages with a NUL byte; the socket uses a
newline, which JSON text never contains raw, so the widget can split lines.

It also refuses to pass on any switch that opens a debugging channel, from
~/.config/youtube-music-flags.conf or its own arguments: --remote-debugging-*
(a leftover port line from an older setup cannot reopen the port) and Node's
--inspect* (Electron honours those in the app's build and opens an
unauthenticated debugger on a TCP port). NODE_OPTIONS and ELECTRON_RUN_AS_NODE
are dropped from the app's environment for the same reason.

Both AUR packages of the app work. pear-desktop-bin is a bundled binary,
/opt/YouTube Music/youtube-music, whose launcher reads
~/.config/youtube-music-flags.conf. pear-desktop (built from source) runs
Arch's system Electron: /usr/bin/pear-desktop reads ~/.config/pear-flags.conf
and runs `electronNN /usr/lib/pear-desktop/app.asar <flags>`, and
/usr/bin/electronNN adds the lines of ~/.config/electronNN-flags.conf (or
electron-flags.conf) in front. The bridge starts /usr/lib/electronNN/electron
itself in that same order, so every one of those files goes through the same
filter (the wrapper would pass them on unfiltered). Both packages run the
same app code, so the window class and the profile folder are the same.

Usage: cdp-bridge [extra app arguments...]
       cdp-bridge --which   prints the app's executable and, for the source
                            package, its app.asar (an empty line otherwise);
                            exits 1 when neither package is installed
Started by the widget when the app is needed, and by the app's menu entry
(tools/setup installs one), so the app is never started with an open port.
"""

import fcntl
import json
import os
import re
import select
import signal
import socket
import stat
import struct
import sys
import syslog
import time
from urllib.parse import urlsplit

CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
BIN_APP = "/opt/YouTube Music/youtube-music"  # pear-desktop-bin
# pear-desktop (source build). The NIC_YTM_* names exist for the tests.
LAUNCHER = os.environ.get("NIC_YTM_LAUNCHER", "/usr/bin/pear-desktop")
ELECTRON_ROOT = os.environ.get("NIC_YTM_ELECTRON_ROOT", "/usr/lib")
# The biggest one message may be, either way. Real answers are a few MB (the
# library); without a cap a peer could make the bridge buffer without end.
# An answer over it is dropped and its asker gets a CDP error instead; a
# client line over it drops that client.
MAX_MESSAGE = 32 * 1024 * 1024
# Bytes waiting to be sent to one connection before it is dropped. Each
# connection has its own queue and the sockets are non-blocking, so one that
# stops reading (a hung or stopped client) never holds up the others: a
# blocking sendall stalled every widget copy and lock-api's quit until that
# client went away (2026-10-01 review).
MAX_QUEUED = 64 * 1024 * 1024
MAX_CLIENTS = 8  # one per monitor copy of the widget, plus a quit from lock-api
claim = None  # the single-bridge lock, held for the bridge's whole life


def say(msg, priority=syslog.LOG_WARNING):
    """To stderr and to the journal (syslog, ident cdp-bridge). The widget
    starts the bridge detached with stderr on /dev/null, so stderr alone left
    a failed start with no trace anywhere (2026-10-01 review). The app's own
    output stays on /dev/null."""
    print("cdp-bridge: " + msg, file=sys.stderr)
    try:
        syslog.syslog(priority, msg)
    except OSError:
        pass


def die(msg, code=1):
    say(msg, syslog.LOG_ERR)
    sys.exit(code)


def private_dir():
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    if not rt:
        die("XDG_RUNTIME_DIR is not set")
    st = os.lstat(rt)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        die("XDG_RUNTIME_DIR is not a private directory owned by this user")
    d = os.path.join(rt, "nic-youtube-music")
    try:
        os.mkdir(d, 0o700)
    except FileExistsError:
        pass
    st = os.lstat(d)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        die(d + " is not a directory owned by this user")
    os.chmod(d, 0o700)
    return d


def opens_debugging(word):
    """True for a switch that opens a debugging channel. Chromium also reads
    switches written with one dash, and Node reads "_" as "-" in its own, so
    the name is compared with both spellings folded."""
    if not word.startswith("-"):
        return False
    name = word.lstrip("-").split("=", 1)[0].replace("_", "-").lower()
    return name.startswith(("remote-debugging-", "inspect"))


def keep(words, source, strip=False):
    out = []
    for word in words:
        if opens_debugging(word.strip() if strip else word):
            say("ignoring " + word.split("=", 1)[0] + " from " + source
                + " (the debugging channel is the private pipe)")
            continue
        out.append(word)
    return out


def find_app():
    """(executable, app.asar or None, electron name or None) for the
    installed app, or None. The source package wins when both are there (it
    is the one the user chose to build)."""
    if os.environ.get("NIC_YTM_APP"):
        return os.environ["NIC_YTM_APP"], None, None
    try:
        with open(LAUNCHER, encoding="utf-8", errors="replace") as f:
            text = f.read(65536)
    except OSError:
        text = ""
    m = re.search(r"^\s*exec\s+(electron\d+)\s+(/\S+\.asar)(\s|$)", text, re.M)
    if m:
        exe = os.path.join(ELECTRON_ROOT, m.group(1), "electron")
        if os.access(exe, os.X_OK) and os.path.isfile(m.group(2)):
            return exe, m.group(2), m.group(1)
    if os.access(BIN_APP, os.X_OK):
        return BIN_APP, None, None
    return None


def flag_words(name):
    """A launcher's flags file read the way pear's launchers do: lines not
    starting with #, split on whitespace."""
    path = os.path.join(CONFIG, name)
    words = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    words += keep(line.split(), path)
    except OSError:
        pass
    return words


def flag_lines(electron):
    """Arch's /usr/bin/electronNN wrapper: one flag per line, from
    electronNN-flags.conf, or electron-flags.conf when that is missing."""
    for name in (electron + "-flags.conf", "electron-flags.conf"):
        path = os.path.join(CONFIG, name)
        try:
            with open(path, encoding="utf-8") as f:
                lines = [line.rstrip("\n") for line in f]
        except OSError:
            continue
        return keep([ln for ln in lines if ln.strip() and not re.match(r"\s*#", ln)], path, strip=True)
    return []


def app_argv(app, extra):
    exe, asar, electron = app
    # The menu entry's %U lands in extra: filtered the same way.
    tail = ["--remote-debugging-pipe"] + keep(extra, "the command line")
    if asar is None:  # pear-desktop-bin: /usr/bin/youtube-music's order
        return [exe] + flag_words("youtube-music-flags.conf") + tail
    # pear-desktop: /usr/bin/electronNN's flags, the app, then pear's flags.
    return [exe] + flag_lines(electron) + [asar] + flag_words("pear-flags.conf") + tail


def app_env(app):
    env = dict(os.environ, ELECTRON_IS_DEV="0")
    if app[1] is not None:  # what /usr/bin/electronNN sets for a packaged app
        env.setdefault("ELECTRON_FORCE_IS_PACKAGED", "true")
    # Node's own switches reach the app's main process through these too.
    for name in ("NODE_OPTIONS", "ELECTRON_RUN_AS_NODE"):
        env.pop(name, None)
    # Name the app's sound streams "YouTube Music". The source package runs as
    # plain electron, the same program name as other Electron apps (Obsidian),
    # so a sound-server rule cannot tell them apart by name; libpulse puts this
    # on the app's connection, over whatever name Chromium sets.
    # Known and accepted (2026-10-02): these variables also reach anything the
    # app itself starts (its xdg-open for a help link), so a browser started
    # that way would label its own sound "YouTube Music". Rare and harmless.
    env["PULSE_PROP_OVERRIDE"] = 'application.name="YouTube Music" application.icon_name="com.github.th-ch.youtube-music"'
    return env


# Every CDP method the widget (Widget.qml, cdpBare and cdpSend) and
# tools/lock-api send, and nothing else. Runtime.evaluate is needed for the
# page itself (Page.js); the rest of the protocol (Network.getAllCookies,
# Storage.*, Target.createTarget, Browser.* and so on) reaches far beyond the
# YouTube Music page, so it is refused (2026-10-01 review). Add a method
# here when the widget starts sending one.
ALLOWED = frozenset({"Target.getTargets", "Target.attachToTarget", "Runtime.evaluate",
                     "Page.navigate", "Browser.close"})


def music_url(url):
    """Exactly https://music.youtube.com/...: no other scheme, host, port or
    user part (the widget only ever navigates back to the app's own page)."""
    if not isinstance(url, str):
        return False
    try:
        u = urlsplit(url)
    except ValueError:
        return False
    return u.scheme == "https" and u.netloc == "music.youtube.com"


def refusal(msg):
    """Why a client's command may not reach the app, or "" when it may."""
    method = msg.get("method")
    if not isinstance(method, str) or method not in ALLOWED:
        return "method not allowed: " + str(method)[:100]
    if method == "Page.navigate":
        params = msg.get("params")
        if not isinstance(params, dict) or not music_url(params.get("url")):
            return "Page.navigate only goes to https://music.youtube.com/"
    return ""


def parse(raw):
    """One JSON object, or None for anything else: not JSON, not an object,
    or nested deeper than the parser allows (that raises RecursionError, not
    ValueError, and used to kill the bridge, 2026-10-01 review)."""
    try:
        msg = json.loads(raw)
    except (ValueError, RecursionError):
        return None
    return msg if isinstance(msg, dict) else None


def dump(msg):
    try:
        return json.dumps(msg, separators=(",", ":")).encode()
    except (ValueError, RecursionError):
        return None


def split_frames(buf, chunk, sep):
    """Add chunk to buf (a bytearray, changed in place) and return the whole
    frames it completes. Only the new chunk is searched for the separator, so
    a big message costs one pass, not one rescan and recopy of everything so
    far for each 64 KB read (that made a 24 MB answer cost 1.2 s of CPU,
    2026-10-01 review)."""
    if sep not in chunk:
        buf += chunk
        return []
    parts = chunk.split(sep)
    buf += parts[0]
    frames = [bytes(buf)] + parts[1:-1]
    buf[:] = parts[-1]
    return frames


# Chromium writes every answer as {"id":N,...}. Swapping N for the asker's id
# as bytes skips parsing and re-encoding the whole answer (a few MB for the
# library). Anything else takes the JSON path, which also re-encodes an
# answer that holds a raw newline, so it cannot break the socket's framing.
ANSWER_HEAD = re.compile(rb'\{"id":(\d+),')


def peer_uid(conn):
    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", creds)[1]


def main():
    app = find_app()
    if sys.argv[1:] == ["--which"]:
        if not app:
            return 1
        print(app[0])
        print(app[1] or "")
        return 0
    if not app:
        die("YouTube Music is not installed (AUR package pear-desktop or pear-desktop-bin)")
    d = private_dir()
    path = os.path.join(d, "cdp.sock")

    # One bridge (so one app) at a time, claimed BEFORE the app starts. The
    # claim is an exclusive lock on a file in the private folder: taking it is
    # atomic, and the kernel drops it when the bridge dies, so it never goes
    # stale. A check-then-bind let two bridges started together both start an
    # app; the loser then crashed on bind (EADDRINUSE) and, with the real app,
    # the single-instance lock could keep the app that had no bridge
    # (2026-10-01 review: 18 of 20 double starts). The lock is never passed
    # to the app (opened close-on-exec).
    global claim
    claim = os.open(os.path.join(d, "bridge.lock"),
                    os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(claim, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0  # another bridge runs, or is starting
    # A socket left behind is stale (its bridge is gone), unless it answers:
    # a bridge from before this lock existed may still be serving it.
    if os.path.lexists(path):
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.connect(path)
            probe.close()
            return 0
        except OSError:
            os.unlink(path)
    old_umask = os.umask(0o177)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        server.bind(path)
    finally:
        os.umask(old_umask)
    os.chmod(path, 0o600)
    server.listen(4)

    to_app_r, to_app_w = os.pipe()        # app reads commands on fd 3
    from_app_r, from_app_w = os.pipe()    # app writes answers on fd 4
    argv = app_argv(app, sys.argv[1:])
    env = app_env(app)

    pid = os.fork()
    if pid == 0:
        try:
            # Park the pipe ends above 4 first so dup2 cannot clobber one with the other.
            a = os.dup(to_app_r)
            b = os.dup(from_app_w)
            os.dup2(a, 3)
            os.dup2(b, 4)
            devnull = os.open(os.devnull, os.O_RDWR)
            for fd in (0, 1, 2):
                os.dup2(devnull, fd)
            os.closerange(5, 1 << 16)
            os.set_inheritable(3, True)
            os.set_inheritable(4, True)
            os.execve(argv[0], argv, env)
        except Exception:
            os._exit(127)
    os.close(to_app_r)
    os.close(from_app_w)

    stopping = []
    # Never forward a TERM to the app: Chromium crashes on purpose on SIGTERM.
    # The widget quits it with Browser.close over this socket instead.
    signal.signal(signal.SIGTERM, lambda *_: stopping.append(1))
    signal.signal(signal.SIGINT, lambda *_: stopping.append(1))
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    # No polling: select wakes when the app exits (a pidfd turns readable)
    # or a signal lands (set_wakeup_fd writes a byte). It used to wake every
    # second to call waitpid. The wakeup pipe matters: Python retries an
    # interrupted select on its own (PEP 475), so without it a SIGTERM went
    # unnoticed until something else happened (2026-10-01 review).
    wakers = []
    try:
        wakers.append(os.pidfd_open(pid))
        wake_r, wake_w = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
        signal.set_wakeup_fd(wake_w)
        wakers.append(wake_r)
        tick = None
    except (AttributeError, OSError):  # no pidfd (Linux before 5.3): poll as before
        wakers, wake_r, tick = [], None, 1.0

    # Every connection is served at once. One copy of the widget runs per
    # monitor and each opens its own connection; when only the newest was
    # kept, the copies kicked each other off while the app started (each
    # polls the page for readiness), and the clicked copy's library load
    # failed with "not reachable" until the panel was reopened (2026-09-28).
    # Command ids are renumbered here so each answer goes back to the
    # connection that asked (every copy counts its ids from 1); events carry
    # no id and go to every connection.
    clients = {}  # socket -> bytes received without a newline yet
    outq = {}     # socket -> bytes waiting to be sent to it
    routes = {}   # bridge id -> (socket, the id that connection used)
    next_id = 0
    from_app = bytearray()
    skipping = False  # inside an app message over MAX_MESSAGE, until its end

    def drop(conn):
        clients.pop(conn, None)
        outq.pop(conn, None)
        for rid in [rid for rid, (c, _) in routes.items() if c is conn]:
            del routes[rid]
        conn.close()

    def flush(conn):
        """Send what the socket takes now; the rest waits for select."""
        try:
            sent = conn.send(outq[conn])
        except BlockingIOError:
            return
        except OSError:
            drop(conn)
            return
        del outq[conn][:sent]

    def queue(conn, lines):
        if conn not in clients:
            return
        outq[conn] += b"".join(line + b"\n" for line in lines)
        if len(outq[conn]) > MAX_QUEUED:
            say("dropped a connection that stopped reading (over %d MiB waiting)" % (MAX_QUEUED >> 20))
            drop(conn)
        else:
            flush(conn)

    def to_app(data):
        # A pipe write can be short when a signal lands mid-write.
        view = memoryview(data)
        while view:
            view = view[os.write(to_app_w, view):]

    try:
        while not stopping:
            done, _status = os.waitpid(pid, os.WNOHANG)
            if done:
                break
            watch = [server, from_app_r] + wakers + list(clients)
            try:
                ready, writable, _ = select.select(watch, [c for c in clients if outq[c]], [], tick)
            except InterruptedError:
                continue
            if wake_r is not None and wake_r in ready:
                try:
                    while os.read(wake_r, 64):
                        pass
                except BlockingIOError:
                    pass
            for conn in [c for c in writable if c in clients]:
                flush(conn)
            if server in ready:
                conn, _ = server.accept()
                if peer_uid(conn) != os.getuid() or len(clients) >= MAX_CLIENTS:
                    conn.close()
                else:
                    conn.setblocking(False)
                    clients[conn] = bytearray()
                    outq[conn] = bytearray()
            if from_app_r in ready:
                chunk = os.read(from_app_r, 1 << 20)
                if not chunk:
                    break  # the app closed its end: it is quitting
                messages = split_frames(from_app, chunk, b"\0")
                out = {}  # socket -> lines to send
                if skipping:
                    if messages:
                        messages.pop(0)  # the end of the message being dropped
                        skipping = False
                    else:
                        from_app.clear()
                if len(from_app) > MAX_MESSAGE:
                    # Answer the asker with an error rather than leave it waiting.
                    m = re.match(rb'\{"id":(\d+),', from_app)
                    route = routes.pop(int(m.group(1)), None) if m else None
                    say("dropped an answer over %d MiB from the app" % (MAX_MESSAGE >> 20))
                    if route and route[0] in clients:
                        out.setdefault(route[0], []).append(dump({"id": route[1], "error": {
                            "code": -32000, "message": "cdp-bridge: answer over %d MiB dropped" % (MAX_MESSAGE >> 20)}}))
                    from_app.clear()
                    skipping = True
                for raw in messages:
                    m = ANSWER_HEAD.match(raw)
                    if m and b"\n" not in raw:
                        route = routes.pop(int(m.group(1)), None)
                        if route and route[0] in clients:
                            their_id = dump(route[1])
                            if their_id is not None:
                                out.setdefault(route[0], []).append(b'{"id":' + their_id + b"," + raw[m.end():])
                        continue
                    msg = parse(raw)
                    if msg is None:
                        continue
                    if "id" in msg:
                        # Only ids this bridge handed out (ints) route anywhere; a
                        # list or object id raised TypeError and killed the bridge.
                        route = routes.pop(msg["id"], None) if type(msg["id"]) is int else None
                        if not route or route[0] not in clients:
                            continue
                        msg["id"] = route[1]
                        line = dump(msg)
                        if line is not None:
                            out.setdefault(route[0], []).append(line)
                    else:
                        for conn in clients:
                            out.setdefault(conn, []).append(raw)
                for conn, lines in out.items():
                    queue(conn, lines)
            for conn in [c for c in ready if c in clients]:
                try:
                    chunk = conn.recv(1 << 20)
                except BlockingIOError:
                    continue
                except OSError:
                    chunk = b""
                if not chunk:
                    drop(conn)
                    continue
                lines = split_frames(clients[conn], chunk, b"\n")
                if len(clients[conn]) > MAX_MESSAGE:
                    say("dropped a connection that sent a line over %d MiB" % (MAX_MESSAGE >> 20))
                    drop(conn)
                    continue
                for line in lines:
                    msg = parse(line)
                    if msg is None:
                        continue
                    why = refusal(msg)
                    if why:
                        say("refused a command: " + why)
                        if "id" in msg:
                            err = {"id": msg["id"], "error": {"code": -32601, "message": "cdp-bridge: " + why}}
                            if isinstance(msg.get("sessionId"), str):
                                err["sessionId"] = msg["sessionId"]
                            queue(conn, [dump(err) or b'{"error":{}}'])
                        continue
                    asked = "id" in msg
                    if asked:
                        their_id = msg["id"]
                        msg["id"] = next_id + 1
                    data = dump(msg)
                    if data is None:
                        continue
                    if asked:
                        next_id += 1
                        routes[next_id] = (conn, their_id)
                    to_app(data + b"\0")
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
        server.close()
        for conn in list(clients):
            conn.close()
        os.close(to_app_w)
        os.close(from_app_r)
    # Reap the app when it exits so it never lingers as a zombie.
    for _ in range(50):
        if os.waitpid(pid, os.WNOHANG)[0]:
            break
        time.sleep(0.1)
    return 0


if __name__ == "__main__":
    syslog.openlog("cdp-bridge", syslog.LOG_PID, syslog.LOG_USER)
    try:
        sys.exit(main())
    except Exception as e:
        say("stopped by an error: %s: %s" % (type(e).__name__, str(e)[:300]), syslog.LOG_ERR)
        raise

#!/bin/bash
# lock-api: lock the YouTube Music app's API server (127.0.0.1:26538) to the
# nic.youtube-music bar widget.
#
# Why: with authStrategy NONE the app's API answers any caller, and its CORS
# allows every origin, so a web page served from your local network (a router
# page, say) or any local program could like songs on your account, queue or
# play things. Browsers ask before a public page reaches 127.0.0.1, but not
# for pages from a private address.
#
# What it does, once: while the app still runs with NONE, it mints a token for
# a random client id (POST /auth/<id> adds the id to the app's authorized
# clients and returns a JWT signed with the app's own secret), saves it mode 600
# in ~/.local/state/omarchy/nic-youtube-music/token (the widget sends it as a
# Bearer header and ?token= on its WebSocket), quits the app (Browser.close
# through tools/cdp-bridge), and switches config.json to AUTH_AT_FIRST while the
# app is closed (the
# app rewrites config.json when it quits). An unknown caller then gets 401, or
# an allow/deny prompt on /auth that defaults to deny.
#
# Fails closed: the NONE window lasts only while this script runs. An EXIT
# trap (errors, Ctrl+C, a closed terminal) quits the app and writes
# AUTH_AT_FIRST whatever happened, so a failed run leaves the API locked
# (without a token the widget says so; run this again). Marketplace review
# omacom/omarchy-plugin-marketplace#8595: the old version exited early on a
# failure with the API left open.
#
# "Locked" is only reported once AUTH_AT_FIRST is read back from config.json,
# the app is gone, and nothing on the port answers without a token. Writing config.json alone does not lock anything:
# a still-running app keeps NONE in memory, answers anyone, and writes NONE
# back over config.json when it finally quits (same review, 2026-09-27). If
# the app will not quit, the script says the API is still open, names the
# process, and exits 1; running it again picks up from that state.
#
# Undo: set authStrategy back to "NONE" in ~/.config/YouTube Music/config.json
# while the app is closed.
set -euo pipefail
cfg="$HOME/.config/YouTube Music/config.json"
tok="$HOME/.local/state/omarchy/nic-youtube-music/token"
api=http://127.0.0.1:26538
app="/opt/YouTube Music/youtube-music"
# The app's main process: the one without --type= (the rest are its helpers).
# Its flags differ by how it was started, so match the path alone.
app_pids() {
  local p
  for p in $(pgrep -f "^$app" || true); do
    tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q -- '--type=' || echo "$p"
  done
}
app_running() { [[ -n $(app_pids) ]]; }

up() { curl -fsS -o /dev/null -m 2 "$@" "$api/api/v1/volume" 2>/dev/null; }
wait_for() { for _ in $(seq 1 "$2"); do eval "$1" && return 0; sleep 0.5; done; return 1; }
# Replaces the file $1 with what "$3..." prints, through a new temp file in
# the same folder. mktemp creates it exclusively with mode 600, so a symlink
# planted at a guessable name (the old "$file.tmp") is never followed and
# nothing else gets truncated; mv then renames over the entry itself. $2 is
# the final mode. On any failure the temp file goes and the target is left
# as it was (marketplace review omacom/omarchy-plugin-marketplace#8595,
# 2026-09-28).
replace_with() {
  local target=$1 mode=$2 tmp
  shift 2
  tmp=$(mktemp -- "$(dirname -- "$target")/.$(basename -- "$target").XXXXXXXX") || return 1
  if "$@" > "$tmp" && chmod "$mode" -- "$tmp" && mv -f -- "$tmp" "$target"; then return 0; fi
  rm -f -- "$tmp"
  return 1
}
set_strategy() {
  replace_with "$cfg" 600 jq --arg s "$1" '.plugins["api-server"].authStrategy = $s' "$cfg"
}
# The closing write: AUTH_AT_FIRST, and in the same write the authorized
# clients. After a mint, only the new id stays: ids from older tokens or
# other clients kept working against the app until dropped (2026-10-01
# review). After a failed mint, the id it asked for is taken out again and
# the rest is left as it was. The id goes to jq through the environment
# (readable by this user only), not its arguments.
lock_config() {
  local filter='.plugins["api-server"].authStrategy = "AUTH_AT_FIRST"'
  if (( minted )); then
    filter+=' | .plugins["api-server"].authorizedClients = [env.NIC_YTM_ID]'
  elif [[ -n ${id:-} ]]; then
    filter+=' | .plugins["api-server"].authorizedClients = ((.plugins["api-server"].authorizedClients // []) - [env.NIC_YTM_ID])'
  fi
  NIC_YTM_ID=${id:-} replace_with "$cfg" 600 jq "$filter" "$cfg"
}
clients_ok() {
  (( minted )) || return 0
  NIC_YTM_ID=$id jq -e '.plugins["api-server"].authorizedClients == [env.NIC_YTM_ID]' "$cfg" >/dev/null 2>&1
}
# What config.json says now, read back rather than assumed from a write.
# A missing authStrategy is the app's own default, AUTH_AT_FIRST (pear-desktop
# 3.12 api-server defaults). Reading it as NONE left a fresh install's API
# locked while this script waited for it to answer without a token, so a first
# setup always failed with "the API did not come up" (found testing the
# panel's Set up on a new profile, 2026-09-28).
strategy_now() { jq -r '.plugins["api-server"].authStrategy // "AUTH_AT_FIRST"' "$cfg" 2>/dev/null; }
strategy_is() { [[ $(strategy_now) == "$1" ]]; }

# Quit the app: through the widget first, then Browser.close straight to the
# bridge's socket (in case the shell is down), and SIGKILL only as the last
# resort. SIGKILL rather than SIGTERM: Chromium crashes on purpose on SIGTERM,
# and a killed app does not write its in-memory NONE back over config.json.
quit_app() {
  app_running || return 0
  omarchy-shell -q nic.youtube-music quit 2>/dev/null || true
  wait_for '! app_running' 30 && return 0
  local sock="${XDG_RUNTIME_DIR:-/run/user/$UID}/nic-youtube-music/cdp.sock"
  if [[ -S $sock ]]; then
    python3 -c 'import socket,sys; s=socket.socket(socket.AF_UNIX); s.settimeout(2); s.connect(sys.argv[1]); s.sendall(b"{\"id\":1,\"method\":\"Browser.close\"}\n")' "$sock" 2>/dev/null || true
    wait_for '! app_running' 20 && return 0
  fi
  local p
  for p in $(app_pids); do kill -KILL "$p" 2>/dev/null || true; done
  wait_for '! app_running' 10
}

# Quits the app, writes AUTH_AT_FIRST, then checks the result. The app writes
# its settings back when it quits, so it has to be closed before AUTH_AT_FIRST
# is written; if it is still running, its in-memory NONE is still live.
close_api() {
  local quit=0
  if quit_app; then quit=1; sleep 1; fi
  # Checked explicitly: close_api runs under `if !`, where set -e is off, so a
  # failed write would otherwise fall through to "Locked" and leave NONE for
  # the next launch (review #8595, 2026-09-28).
  if ! lock_config || ! strategy_is AUTH_AT_FIRST || ! clients_ok; then
    echo "NOT LOCKED: could not write authStrategy AUTH_AT_FIRST (and the authorized clients) to $cfg, so the app's next start would answer anyone." >&2
    echo "Check the file can be written (disk space, permissions), then run this again." >&2
    return 1
  fi
  (( quit )) && ! up && return 0
  echo "NOT LOCKED: YouTube Music would not quit, so its API still answers without a token." >&2
  echo "It will also write NONE back into config.json when it exits. Close it, then run this again:" >&2
  echo "  kill -KILL $(app_pids | tr '\n' ' ')" >&2
  return 1
}

# Runs on every exit once the API may be open, including the normal one: the
# lock and the "Locked" message both come from here, after close_api checked.
opened=0 minted=0 id=
lock_on_exit() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if (( opened )); then
    if ! close_api; then
      rc=1
    elif (( minted )); then
      echo "Locked: authStrategy AUTH_AT_FIRST, token in $tok. The widget starts the app again when needed."
    else
      echo "Stopped before finishing: the API is locked again (AUTH_AT_FIRST) but has no working token. Run this again." >&2
      (( rc )) || rc=1
    fi
  fi
  exit "$rc"
}
trap lock_on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

[[ -f $cfg ]] || { echo "No $cfg: start YouTube Music once and sign in first." >&2; exit 1; }
strategy=$(strategy_now)

# "Already locked" needs the API to refuse a caller without a token too: after
# a run where the app would not quit, config.json says AUTH_AT_FIRST and the
# token exists, but the running app still answers anyone.
if [[ $strategy == AUTH_AT_FIRST && -s $tok ]] && ! up; then
  echo "Already locked (AUTH_AT_FIRST, token present)."
  exit 0
fi

# 1. The app must be running with auth NONE to mint a token without a prompt.
# From here on the API may answer anyone, so the exit trap takes over. An app
# that already answers without a token is open whatever config.json says, so
# go on and lock it rather than asking for a quit it may refuse again.
if [[ $strategy != NONE ]] && app_running && ! up; then
  echo "Quit YouTube Music first: omarchy-shell nic.youtube-music quit" >&2; exit 1
fi
opened=1
[[ $strategy == NONE ]] || set_strategy NONE
if ! up; then
  omarchy-shell -q nic.youtube-music wake
  wait_for up 60 || { echo "YouTube Music's API did not come up." >&2; exit 1; }
fi

# 2. Mint and save the token.
# The client id (half of what a forged token needs) and the token reach curl
# on stdin as config lines (-K -), never as arguments: every user can read a
# process's arguments in /proc/<pid>/cmdline. printf is a shell builtin, so
# it never shows there either (2026-10-01 review).
id="nic-bar-$(openssl rand -hex 16)"
token=$(printf 'url = "%s"\n' "$api/auth/$id" | curl -fsS -m 10 -X POST -K - | jq -r '.accessToken // empty')
[[ -n $token ]] || { echo "The app gave no token." >&2; exit 1; }
mkdir -p "${tok%/*}"
printf '%s\n' "$token" | replace_with "$tok" 600 cat
printf 'header = "Authorization: Bearer %s"\n' "$token" | up -K - || { echo "The new token does not work." >&2; exit 1; }

minted=1

# 3. Nothing left to do here: the exit trap quits the app (Browser.close
# through the bridge first; Chromium crashes on purpose on SIGTERM), writes
# AUTH_AT_FIRST, and only then says "Locked", once it has checked.

#!/bin/bash
# Offscreen tests for Widget.qml and Page.js: the real Widget.qml, loaded by
# qmltestrunner against stub Quickshell and Omarchy modules (stubs/), so
# nothing is drawn on screen, nothing is started, no file of the user's is
# read or written, and the YouTube Music app is never contacted.
#
#   tests/qml/run            every test, then 20 fresh loads of the widget
#   tests/qml/run --quick    every test once (a few seconds)
#   tests/qml/run --quick --only tst_lyrics.qml   one test file
#
# It runs in its own network namespace (unshare -rn), so even the widget's
# plain XMLHttpRequest calls to 127.0.0.1:26538 cannot reach a running app.
# Any QML warning that points into Widget.qml fails the run.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
if [ -z "${YTM_QML_NETNS:-}" ]; then
  if ! unshare -rn true 2>/dev/null; then
    echo "These tests need a private network namespace (unshare -rn); user namespaces look disabled." >&2
    exit 2
  fi
  YTM_QML_NETNS=1 exec unshare -rn "$0" "$@"
fi

quick=0
input=$here
while [ $# -gt 0 ]; do
  case "$1" in
    --quick) quick=1 ;;
    --only) shift; input=$here/${1:?--only needs a file}; [ -f "$input" ] || { echo "no such test: $1" >&2; exit 2; } ;;
    *) echo "usage: $0 [--quick] [--only tst_name.qml]" >&2; exit 2 ;;
  esac
  shift
done
runner=${QMLTESTRUNNER:-/usr/lib/qt6/bin/qmltestrunner}
[ -x "$runner" ] || runner=$(command -v qmltestrunner6 || command -v qmltestrunner || true)
[ -n "$runner" ] || { echo "qmltestrunner not found (qt6-declarative)" >&2; exit 2; }

scratch=$(mktemp -d "${TMPDIR:-/tmp}/ytm-qml.XXXXXX")
trap 'rm -rf "$scratch"' EXIT
mkdir -m 700 "$scratch/rt"

# A clean environment: no display, no session bus, a scratch HOME and XDG
# folders, so Qt itself writes nothing outside the scratch folder.
qt() {
  env -i PATH=/usr/bin:/bin LANG=C.UTF-8 HOME="$scratch" XDG_RUNTIME_DIR="$scratch/rt" \
    XDG_CONFIG_HOME="$scratch/.config" XDG_CACHE_HOME="$scratch/.cache" XDG_DATA_HOME="$scratch/.local/share" \
    XDG_STATE_HOME="$scratch/.local/state" TMPDIR="$scratch" QT_QPA_PLATFORM=offscreen QML_DISABLE_DISK_CACHE=1 \
    "$runner" -import "$here/stubs" "$@"
}

fail=0
own_warnings() {
  grep -E "(Widget\.qml|Page\.js):[0-9]+" "$1" | grep -vE "^(PASS|QDEBUG)" | grep -vE "QML (ArtImage|Image): "
}
check() {
  # $1: log. A test failure, or any warning from the widget's own files.
  if grep -E "^(FAIL|Totals:.* [1-9][0-9]* failed)" "$1" >/dev/null; then fail=1; fi
  # Image load errors are Qt reporting a URL it could not fetch (there is no
  # network in here), not a fault in the code.
  if own_warnings "$1" >/dev/null; then
    echo "--- warnings from the widget's own files:"; own_warnings "$1" | head -20
    fail=1
  fi
}

log="$scratch/all.log"
qt -input "$input" > "$log" 2>&1 || true
[ -n "${YTM_QML_LOG:-}" ] && cp "$log" "$YTM_QML_LOG"
grep -E "^(FAIL|Totals)|^   (Actual|Expected)|Loc:" "$log" || true
check "$log"

if [ $quick = 0 ]; then
  # The shell crashed in Qt's JS garbage collector on some starts when a
  # plugin did heavy work while loading (1 in 12 once). 20 fresh processes
  # each load the widget and wait a moment.
  loads=0
  for i in $(seq 1 20); do
    l="$scratch/load$i.log"
    qt -input "$here/tst_load.qml" > "$l" 2>&1 || true
    check "$l"
    grep -qE "^Totals: [1-9][0-9]* passed, 0 failed" "$l" && loads=$((loads + 1))
  done
  echo "Fresh loads: $loads of 20 clean"
  [ $loads = 20 ] || fail=1
fi

[ $fail = 0 ] && echo "RESULT: PASS" || echo "RESULT: FAIL"
exit $fail
